FROM node:24.19.0-trixie-slim
ARG PAIOS_BUILD_MAINLAND_MIRRORS=0
ENV ONNXRUNTIME_NODE_INSTALL=skip
ENV PNPM_HOME=/usr/local/share/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"
RUN if [ "$PAIOS_BUILD_MAINLAND_MIRRORS" = "1" ]; then sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources; export npm_config_registry=https://registry.npmmirror.com; fi && apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-yaml ffmpeg util-linux ca-certificates openssh-client git && rm -rf /var/lib/apt/lists/* && npm install -g pnpm@11.9.0
RUN if [ "$PAIOS_BUILD_MAINLAND_MIRRORS" = "1" ]; then export PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple; fi && python3 -m venv /opt/paios-vision && /opt/paios-vision/bin/pip install --no-cache-dir opencv-python-headless==4.12.0.88 numpy==2.2.6
ENV PAIOS_VISION_PYTHON=/opt/paios-vision/bin/python
# BuildKit applies ADD --chmod to the parent directories it creates; make them traversable for UID 10000 first.
RUN install -d -m 0755 /models /models/faces
ADD --chmod=0644 --checksum=sha256:8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4 https://media.githubusercontent.com/media/opencv/opencv_zoo/47534e27c9851bb1128ccc0102f1145e27f23f98/models/face_detection_yunet/face_detection_yunet_2023mar.onnx /models/faces/face_detection_yunet_2023mar.onnx
ADD --chmod=0644 --checksum=sha256:c83b8120c50ccbd4c4f96edf53141bdd566ebb8f8e9227e415326aa1b1aba958 https://raw.githubusercontent.com/opencv/opencv_zoo/47534e27c9851bb1128ccc0102f1145e27f23f98/models/face_detection_yunet/LICENSE /models/faces/face_detection_yunet.LICENSE
ADD --chmod=0644 --checksum=sha256:a140c9e9574ff99d3dc1c435d5e8b5e60690dc91597e66387cbbb52be12cce4c https://raw.githubusercontent.com/opencv/opencv_zoo/47534e27c9851bb1128ccc0102f1145e27f23f98/models/face_detection_yunet/README.md /models/faces/face_detection_yunet.README.md
ADD --chmod=0644 --checksum=sha256:0ba9fbfa01b5270c96627c4ef784da859931e02f04419c829e83484087c34e79 https://media.githubusercontent.com/media/opencv/opencv_zoo/47534e27c9851bb1128ccc0102f1145e27f23f98/models/face_recognition_sface/face_recognition_sface_2021dec.onnx /models/faces/face_recognition_sface_2021dec.onnx
ADD --chmod=0644 --checksum=sha256:cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30 https://raw.githubusercontent.com/opencv/opencv_zoo/47534e27c9851bb1128ccc0102f1145e27f23f98/models/face_recognition_sface/LICENSE /models/faces/face_recognition_sface.LICENSE
ADD --chmod=0644 --checksum=sha256:e090e126f3fb5c0b0b2d84ee644b17e42a70b2e45a90616814970b811e91d063 https://raw.githubusercontent.com/opencv/opencv_zoo/47534e27c9851bb1128ccc0102f1145e27f23f98/models/face_recognition_sface/README.md /models/faces/face_recognition_sface.README.md
WORKDIR /opt/paios
COPY --chmod=a+rX,go-w 01-product-half-finished/backend 01-product-half-finished/backend
COPY --chmod=a+rX,go-w integrations integrations
COPY --chmod=a+rX,go-w capability capability
COPY --chmod=a+rX,go-w deploy/cloud/model-settings-project.ts deploy/cloud/model-settings-project.ts
COPY --chmod=a+rX,go-w deploy/cloud/model-settings-call-intent.ts deploy/cloud/model-settings-call-intent.ts
# The terminal simulator reads the same endpoint contract as the native clients.
COPY --chmod=a+rX,go-w 01-product-half-finished/apple/current-mac-source-20260930/clients/phase0/apple-native/PersonalAIOSPhase0/OpenSource/apple-health-exporter/app/Contracts/client-endpoints.json 01-product-half-finished/apple/current-mac-source-20260930/clients/phase0/apple-native/PersonalAIOSPhase0/OpenSource/apple-health-exporter/app/Contracts/client-endpoints.json
COPY --chmod=a+rX,go-w scripts/call-handoff-eval scripts/call-handoff-eval
RUN if [ "$PAIOS_BUILD_MAINLAND_MIRRORS" = "1" ]; then export npm_config_registry=https://registry.npmmirror.com; fi && \
    cd 01-product-half-finished/backend/phase0/gateway && pnpm install --prod --frozen-lockfile && \
    cd ../../services/personal-aios-integration && ONNXRUNTIME_NODE_INSTALL=skip npm ci --omit=dev && \
    rm -rf node_modules/onnxruntime-node/bin/napi-v6/darwin node_modules/onnxruntime-node/bin/napi-v6/win32 && \
    find node_modules/onnxruntime-node/bin/napi-v6/linux -mindepth 1 -maxdepth 1 ! -name "$(node -p process.arch)" -exec rm -rf {} + && \
    cd ../platform-data && pnpm install --prod --frozen-lockfile && \
    cd ../qwen-embedded && npm ci --omit=dev
RUN groupadd -g 10000 paios && useradd -u 10000 -g 10000 -m paios && mkdir -p /var/lib/paios/state/errands /var/lib/paios/desktop-in /var/lib/paios/central-storage/model-settings /var/lib/paios/model-projections /var/lib/paios/core-profile/memories && chown -R paios:paios /var/lib/paios
# Libraries read this: LiveKit's logger otherwise writes debug lines to stdout, which also carries the sim client's JSON.
ENV NODE_ENV=production
USER paios
CMD ["node", "01-product-half-finished/backend/phase0/gateway/src/rayneo-persistent-production-entrypoint.ts", "--execution-owner", "hermes_text", "--config", "/etc/paios/cloud.json"]
