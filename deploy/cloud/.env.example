# Single Linux host. Copy to .env, set the brain API key, then run sh deploy/cloud/build.sh --up.
PAIOS_PROJECT=personal-ai-os
# Empty detects the deployer's IANA time zone during rendering.
PAIOS_TIME_ZONE=
PAIOS_DEPLOYMENT=single-host
COMPOSE_PROFILES=single-host
PAIOS_PUBLIC_HOST=localhost
PAIOS_PUBLIC_IPV4=127.0.0.1
PAIOS_TLS_PORT=8443
PAIOS_SECRETS_DIR=./.local/secrets
PAIOS_TLS_DIR=./.local/tls
PAIOS_GATEWAY_IMAGE=paios-gateway:0.0.2
PAIOS_HERMES_IMAGE=paios-hermes:0.0.2
PAIOS_FRONT_IMAGE=paios-front:0.0.2
PAIOS_WORKSHOP_IMAGE=paios-workshop:0.0.2
PAIOS_POSTGRES_IMAGE=postgres:18.6
PAIOS_LIVEKIT_IMAGE=livekit/livekit-server:v1.9.0
PAIOS_BUILD_MAINLAND_MIRRORS=0
# Every model and endpoint is deployment configuration. Optional roles stay off when MODEL is empty.
# The brain accepts any OpenAI-compatible Chat Completions endpoint.
PAIOS_BRAIN_MODEL=deepseek-flash
PAIOS_BRAIN_BASE_URL=https://api.deepseek.com
PAIOS_BRAIN_API_KEY=
PAIOS_BRAIN_CONTEXT_LIMIT=262144
PAIOS_BRAIN_MAX_OUTPUT_TOKENS=8192
PAIOS_VISION_MODEL=
PAIOS_VISION_BASE_URL=
PAIOS_VISION_API_KEY=
PAIOS_EXECUTOR_FAST_MODEL=
PAIOS_EXECUTOR_FAST_BASE_URL=
PAIOS_EXECUTOR_FAST_API_KEY=
PAIOS_EXECUTOR_THOROUGH_MODEL=
PAIOS_EXECUTOR_THOROUGH_BASE_URL=
PAIOS_EXECUTOR_THOROUGH_API_KEY=
# Realtime and TTS require the existing DashScope-compatible protocols and local audio assets.
PAIOS_REALTIME_MODEL=
PAIOS_REALTIME_BASE_URL=
PAIOS_REALTIME_API_KEY=
PAIOS_REALTIME_VOICE=
PAIOS_TTS_MODEL=
PAIOS_TTS_BASE_URL=
PAIOS_TTS_API_KEY=
PAIOS_TTS_VOICE=
PAIOS_WORKSHOP_REPAIR_MODEL=
PAIOS_WORKSHOP_REPAIR_BASE_URL=
PAIOS_WORKSHOP_REPAIR_API_KEY=
PAIOS_ENABLE_PHONE=0
PAIOS_PHONE_PROVIDER=off
PAIOS_AGENTBAY_IMAGE=
PAIOS_ENABLE_OWNER_MAC=0
PAIOS_ENABLE_EDGE=0
PAIOS_ENABLE_COLD_STORAGE=0
PAIOS_ENABLE_AVATAR=0
PAIOS_ENABLE_AMAP=0
PAIOS_ENABLE_MIHOME=0
PAIOS_ENABLE_WECHAT=0
PAIOS_ENABLE_SELF_REPAIR=0
# Existing optional services need their own account/configuration before their switch is set to 1.
PAIOS_COLD_CONFIG_DIR=./.local/cold
PAIOS_STAGING_COLD_CONFIG_DIR=./.local/staging-cold
PAIOS_STAGING_SECRETS_DIR=./.local/staging-secrets
PAIOS_STAGING_MODEL_SETTINGS_ENVIRONMENT=staging
PAIOS_STAGING_PUBLIC_API_URL=https://localhost:18443
PAIOS_STAGING_LIVEKIT_URL=wss://localhost:18443
PAIOS_DASHSCOPE_ENDPOINT=
PAIOS_WORKSHOP_DENY_HOSTS=localhost
