FROM debian:13.4@sha256:e2d08da6f42ef4b09b165d55528a12727aeed8240dc9edf888e3ec07e10ef9da
ARG PAIOS_BUILD_MAINLAND_MIRRORS=0
RUN if [ "$PAIOS_BUILD_MAINLAND_MIRRORS" = "1" ]; then sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources; fi && apt-get update && apt-get install -y --no-install-recommends openssh-server python3-venv python3-pip python3-yaml python3-openpyxl python3-docx python3-pypdf git curl ca-certificates iptables util-linux socat libseccomp2 && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_*
COPY --chmod=a+rX,go-w capability /opt/yimi/capability
COPY --chmod=a+rX,go-w 01-product-half-finished/backend/services/personal-aios-integration/src/capability/registry/*.py /opt/yimi/registration/
# Reuse only the product toolchain/dependencies; repair workspaces never receive another revision's source.
COPY --from=gateway_runtime /usr/local/ /usr/local/
COPY --from=gateway_runtime /opt/paios/01-product-half-finished/backend/phase0/gateway/node_modules /opt/paios-test-deps/phase0/gateway/node_modules
COPY --from=gateway_runtime /opt/paios/01-product-half-finished/backend/services/personal-aios-integration/node_modules /opt/paios-test-deps/services/personal-aios-integration/node_modules
COPY --from=gateway_runtime /opt/paios/01-product-half-finished/backend/services/platform-data/node_modules /opt/paios-test-deps/services/platform-data/node_modules
COPY --from=gateway_runtime /opt/paios/01-product-half-finished/backend/services/qwen-embedded/node_modules /opt/paios-test-deps/services/qwen-embedded/node_modules
# Native file lint invokes npx from the repair checkout; provide its declared compiler on the executable image.
COPY --from=gateway_runtime /opt/paios/01-product-half-finished/backend/phase0/gateway/package.json /tmp/paios-gateway-package.json
RUN if [ "$PAIOS_BUILD_MAINLAND_MIRRORS" = "1" ]; then export npm_config_registry=https://registry.npmmirror.com; fi && npm install --prefix /opt/paios-repair-tools --ignore-scripts --no-audit --no-fund "typescript@$(node -p 'require("/tmp/paios-gateway-package.json").devDependencies.typescript')" && rm /tmp/paios-gateway-package.json
RUN useradd --uid 10001 --create-home --home-dir /home/yimi --shell /bin/bash yimi && passwd -d yimi && passwd -d root && printf '%s\n' 'Port 2222' 'HostKey /var/lib/workshop-ssh/host_ed25519' 'AuthorizedKeysFile /run/workshop-access/authorized_keys' 'PasswordAuthentication no' 'KbdInteractiveAuthentication no' 'PermitRootLogin forced-commands-only' 'AllowUsers root' 'DisableForwarding yes' 'PermitUserEnvironment no' 'PermitUserRC no' 'UsePAM no' 'ClientAliveInterval 5' 'ClientAliveCountMax 3' 'PidFile /run/sshd.pid' 'Subsystem sftp internal-sftp' 'SetEnv PATH=/usr/local/bin:/usr/bin:/bin' > /etc/ssh/sshd_config
COPY --chmod=0755 deploy/cloud/workshop-scope.py /usr/local/bin/workshop-scope
COPY deploy/cloud/workshop_snapshot.py /usr/local/bin/workshop_snapshot.py
COPY --chmod=0755 deploy/cloud/workshop-start.sh /usr/local/bin/workshop-start
RUN chmod 755 /usr/local/bin/workshop-start /usr/local/bin/workshop-scope && printf '%s\n' 'export PATH=/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin PIP_USER=1 PIP_BREAK_SYSTEM_PACKAGES=1 NPM_CONFIG_PREFIX=$HOME/.local' > /etc/profile.d/workshop.sh && if [ "$PAIOS_BUILD_MAINLAND_MIRRORS" = "1" ]; then printf '%s\n' 'export PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple NPM_CONFIG_REGISTRY=https://registry.npmmirror.com' >> /etc/profile.d/workshop.sh; fi
RUN install -d -o 0 -g 0 -m 700 /srv/owner && install -d -o 0 -g 0 -m 755 /srv/owner/in /srv/owner/out /owner /owner/in /owner/out && touch /srv/owner/config.json
ENTRYPOINT ["/usr/local/bin/workshop-start"]
