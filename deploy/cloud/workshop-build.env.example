# Operator fills these paths and installs keys. Never commit a real key or owner config.
PAIOS_BUILDER_PROJECT=paios-workshop-builder
PAIOS_HERMES_IMAGE=paios-hermes:workshop-builder
PAIOS_WORKSHOP_IMAGE=paios-workshop:workshop-builder
# Standalone builder beside staging; do not use staging's synthetic-secrets here.
PAIOS_SECRET_ROOT=/srv/paios/builder-secrets
# Open this host port only after the cloud firewall allows production's egress IPv4 alone.
# To expose it deliberately, replace 127.0.0.1 with the host's selected interface address.
PAIOS_BUILDER_BIND=127.0.0.1
PAIOS_BUILDER_PORT=18664
PAIOS_BUILDER_MAX_TOOL_CALLS=120
PAIOS_BUILDER_TOOL_CALL_MILESTONE_INTERVAL=20
PAIOS_BUILDER_PUBLIC_IPV4_FILE=/etc/paios/workshop-builder-public-ipv4
# This file lists the build host's public IPv4 for the sandbox firewall to deny its own public IP.
# It does not set the TLS bind address or supply the TLS certificate.
PAIOS_WORKSHOP_DENY_HOSTS=owner-api.example.invalid,owner-livekit.example.invalid

# Model settings authority: projection directory and service/journal endpoints.
# The builder mounts PAIOS_MODEL_SETTINGS_PROJECTION_DIR at /etc/paios/model-settings:ro; must contain current.json.
PAIOS_MODEL_SETTINGS_PROJECTION_DIR=/etc/paios/model-settings
PAIOS_MODEL_SETTINGS_SERVICE_URL=https://model-settings.example.invalid
PAIOS_MODEL_SETTINGS_JOURNAL_URL=https://deployment-hermes.example.invalid

# Release runner queue and source repository:
# PAIOS_RELEASE_REQUESTS: host directory mounted at /srv/release-requests where the builder writes repair requests and patches.
PAIOS_RELEASE_REQUESTS=/srv/paios/release-requests
# PAIOS_RELEASE_REPO: build host's shared Git repository directory mounted read-only at /srv/source.git.
PAIOS_RELEASE_REPO=/srv/paios/product-source.git

# Model routes and provider keys come from the settings authority's projection and service credential.
# model-settings-service.key: the deployment's model-settings service bearer (same value on both sides); authenticates settings-service calls, usage journal posts and the deployment's model activation request; mode 0400, owner UID 10000.
# workshop-builder.key: independent bearer shared with production, mode 0400, owner UID 10000.
# workshop-builder.tls.key: server private key, mode 0400, owner UID 10000.
# workshop-builder.crt: self-signed server certificate, mode 0444, owner root.
# The certificate must contain the build host's public IPv4 in subjectAltName (IP:...).
# Install the same certificate and bearer in the production and staging secret dirs.
# Production bridge: PAIOS_BUILDER_URL=https://<builder-public-IPv4>:18664
# Production bridge: PAIOS_BUILDER_TOKEN_FILE=/run/secrets/workshop-builder.key
# Production bridge: PAIOS_BUILDER_CA_FILE=/run/secrets/workshop-builder.crt
