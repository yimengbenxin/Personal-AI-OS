+import pytest
+
+from agent.memory_manager import inject_memory_provider_tools
+from gateway.run_scope import restrict_agent, tool_block
+from tools.mcp_tool_agent import refresh_agent_mcp_tools
+
+
+PROVIDER_NAMES = {"paios_open_reply", "paios_senses", "paios_navigate", "paios_payment"}
+
+
+@pytest.mark.parametrize("scope", ["owner", "guest", "owner_uncertain", "care"])
+def test_child_provider_refresh_preserves_admission(scope, monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    schemas = [{"name": name, "description": name, "parameters": {"type": "object", "properties": {}}}
+               for name in sorted(PROVIDER_NAMES)]
+    parent = SimpleNamespace(valid_tool_names={"paios_open_reply"}, _paios_delegate_toolsets=["web"])
+    child = SimpleNamespace(
+        tools=[], valid_tool_names=set(), enabled_toolsets=[], disabled_toolsets=["memory"],
+        _memory_manager=SimpleNamespace(get_all_tool_schemas=lambda: schemas),
+        _paios_tool_conversation="admitted-session", _paios_delegate_toolsets=["web"],
+        _delegate_depth=1, _paios_run_scope=scope, _paios_action_denied={"paios_payment"},
+        side_agent=True, platform="subagent",
+    )
+    assert inject_memory_provider_tools(child, inherit_from=parent) == len(PROVIDER_NAMES)
+    restrict_agent(child, scope)
+    expected = set(child.valid_tool_names)
+    assert "paios_open_reply" in expected
+    assert ("paios_senses" in expected) == (scope == "owner")
+    # The actual registry rebuild has no provider registration and no builtin memory.
+    refresh_agent_mcp_tools(child, preserve_prefix=True)
+    restrict_agent(child, scope)
+    assert child.valid_tool_names == expected
+    assert "memory" not in child.valid_tool_names
+    assert tool_block(child, "paios_payment") is not None
+    if scope != "owner":
+        assert tool_block(child, "paios_senses") is not None
