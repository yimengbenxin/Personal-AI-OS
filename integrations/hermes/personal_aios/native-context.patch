+@pytest.mark.parametrize("case", ["changed", "unchanged", "removed", "disabled", "other-code", "legacy", "no-manager", "no-provider"])
+def test_external_current_contract_and_core_prefix_have_distinct_owners(monkeypatch, case):
+    old_core, fresh_core = tool("read_file", "pinned core"), tool("read_file", "fresh core")
+    old, fresh = tool("paios_open_reply", "old"), tool("paios_open_reply", "exact current D copy or omit")
+    if case == "unchanged": fresh = copy.deepcopy(old)
+    schemas = [fresh["function"], fresh_core["function"]] if case != "removed" else []
+    definitions = [fresh_core] if case in {"removed", "disabled"} else [fresh_core, fresh]
+    a = agent(monkeypatch, definitions, schemas)
+    if case == "no-manager": del a._memory_manager
+    if case == "no-provider": a._memory_manager = MemoryManager()
+    repins = []
+    monkeypatch.setattr(owner, "persist_agent_tool_names", lambda current: repins.append(copy.deepcopy(current.tools)))
+    if hasattr(a, "_memory_manager"):
+        a._memory_manager.get_all_tool_schemas = lambda: pytest.fail("restore must not fetch provider schemas")
+    assert "read_file" not in getattr(a, "_memory_manager", MemoryManager()).get_all_tool_names()  # real reserved-name authority
+    saved = {"version": "other-code" if case == "other-code" else "same-code", "tools": [old, old_core]}
+    if case == "legacy": saved = ["paios_open_reply", "read_file"]
+    original = copy.deepcopy(saved)
+    owner.restore_agent_tool_prefix(a, saved)
+    expected_core = fresh_core if case in {"other-code", "legacy"} else old_core
+    expected_external = old if case in {"no-manager", "no-provider"} else fresh
+    assert a.tools == ([expected_core] if case in {"removed", "disabled"} else [expected_external, expected_core])
+    assert bool(repins) == (case in {"changed", "removed", "disabled", "other-code", "legacy"})
+    assert saved == original
+    assert a.valid_tool_names == {t["function"]["name"] for t in a.tools}
+
