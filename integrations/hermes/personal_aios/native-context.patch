+               for name in sorted(PROVIDER_NAMES)]
+    parent = SimpleNamespace(valid_tool_names={"paios_open_reply"}, _paios_delegate_toolsets=[])
+    child = SimpleNamespace(
+        tools=[], valid_tool_names=set(), enabled_toolsets=[], disabled_toolsets=["memory"],
+        _memory_manager=SimpleNamespace(get_all_tool_schemas=lambda: schemas),
+        _paios_tool_conversation="admitted-session", _paios_delegate_toolsets=[],
+        _delegate_depth=1, side_agent=True, platform="subagent",
+    )
+    assert inject_memory_provider_tools(child, inherit_from=parent) == 1
+    assert child.valid_tool_names == {"paios_open_reply"}
+    refresh_agent_mcp_tools(child, preserve_prefix=True)
+    assert child.valid_tool_names == {"paios_open_reply"}
+    assert "memory" not in child.valid_tool_names
