+        def handle_tool_call(self, tool_name, args, **kwargs):
+            return json.dumps({"name": tool_name, "args": args})
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    manager = MemoryManager()
+    manager.add_provider(Provider())
+    parent = AIAgent(api_key="synthetic", base_url="http://127.0.0.1:9/v1", provider="custom",
+        api_mode="chat_completions", model="fixture", session_id="parent", platform="api_server",
+        quiet_mode=True, skip_context_files=True, skip_memory=True, save_trajectories=False,
+        enabled_toolsets=[])
+    parent._memory_manager = manager
+    parent._paios_tool_conversation = "admitted-session"
+    parent._paios_delegate_toolsets = ["web"]
+    child = _build_child_agent(task_index=0, goal="Get location and request payment", context=None,
+        toolsets=["web"], model=None, max_iterations=4, task_count=1, parent_agent=parent)
