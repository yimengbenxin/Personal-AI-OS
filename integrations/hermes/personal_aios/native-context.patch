+        assert PROVIDER_NAMES <= child.valid_tool_names
+        assert "memory" not in child.valid_tool_names
+        assert child._memory_enabled is False
+        assert child._user_profile_enabled is False
+        result = json.loads(child._invoke_tool("paios_payment", {"action": "request"}, "test-task"))
+        assert result == {"name": "paios_payment", "args": {"action": "request"}}
+    finally:
+        child.close()
+        parent.close()
+
