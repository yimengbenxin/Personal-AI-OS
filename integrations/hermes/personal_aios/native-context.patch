+def agent(monkeypatch, definitions, provider_schemas):
+    manager = MemoryManager()
+    manager.add_provider(types.SimpleNamespace(name="private-external",
+        get_tool_schemas=lambda: copy.deepcopy(provider_schemas)))
+    monkeypatch.setattr(owner, "tool_pin_version", lambda: "same-code")
+    monkeypatch.setattr(registry_mod.registry, "get_all_entries", lambda: [types.SimpleNamespace(name="read_file")])
+    return types.SimpleNamespace(tools=copy.deepcopy(definitions), _memory_manager=manager,
+        valid_tool_names={t["function"]["name"] for t in definitions}, enabled_toolsets=None,
+        disabled_toolsets=None, side_agent=False, _session_db=None)
