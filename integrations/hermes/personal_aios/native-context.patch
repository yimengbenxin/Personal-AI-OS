@@ -0,0 +1,135 @@
+"""A host transport must own every spawn without changing the process environment."""
+import json
+import os
+from types import SimpleNamespace
+
+import pytest
+
+from tools.computer_use import cua_backend as cb
+from tools.computer_use import cua_backend_driver as driver
+from tools.computer_use import cua_backend_session as session
+from tools.computer_use import tool
+from tools.computer_use.cua_backend_transport import DriverTransport
+
+
+def spec():
+    return {"command": "/product/owner-cua", "args": ["device-a"], "env": {"CUA_BINDING": "a"}}
+
+
+def manifest():
+    return {"binary_version": "0.20.0", "mcp_invocation": {"command": "/remote/cua-driver", "args": ["mcp"]},
+            "subcommands": [{"name": name, "args": [{"name": arg} for arg in args]}
+                            for name, args in driver._CUA_DRIVER_RUNTIME_CONTRACT_ARGS.items()]}
+
+
+def test_manifest_and_cli_keep_wrapper_and_remote_screenshot_inline(monkeypatch):
+    original = dict(os.environ)
+    supplied = spec()
+    transport = DriverTransport(supplied)
+    supplied["args"].append("changed")
+    supplied["env"]["CUA_BINDING"] = "changed"
+    spawned = []
+
+    def run(argv, **kwargs):
+        spawned.append((argv, kwargs["env"]))
+        return SimpleNamespace(returncode=0, stdout=json.dumps(manifest()), stderr="")
+
+    monkeypatch.setattr(cb, "_run_quiet", run)
+    monkeypatch.setattr(cb, "_cua_no_overlay", lambda: False)
+    assert transport.mcp_invocation() == ("/product/owner-cua", ["device-a", "mcp"])
+    assert spawned[0][0] == ["/product/owner-cua", "device-a", "manifest"]
+    assert spawned[0][1]["CUA_BINDING"] == "a"
+    with pytest.raises(TypeError):
+        transport.spec["env"]["CUA_BINDING"] = "b"
+    native = session._CuaDriverSession(None, driver_transport=transport)
+    calls = []
+    monkeypatch.setattr(session, "_cli_run_json", lambda argv, env, name, timeout: calls.append(argv) or {"ok": True})
+    monkeypatch.setattr(session, "_cli_result", lambda result, path, **kwargs: (result, path))
+    assert native._call_tool_via_cli("get_window_state", {"pid": 12}, 3) == ({"ok": True}, None)
+    assert calls[0][:4] == ["/product/owner-cua", "device-a", "call", "get_window_state"]
+    assert json.loads(calls[0][4]) == {"pid": 12}
+    assert dict(os.environ) == original
+
+
+def test_explicit_transport_rejects_permission_bypass():
+    for mode in ("bounded", "unrestricted"):
+        with pytest.raises(ValueError, match="only standard"):
+            cb.CuaDriverBackend(permission_mode=mode, driver_transport=spec())
+
+
+def test_factory_binding_reuses_replaces_and_releases_original_session(monkeypatch):
+    created, stopped = [], []
+
+    class Backend(tool._NoopBackend):
+        def start(self):
+            created.append(self)
+
+        def stop(self):
+            stopped.append(self)
+
+    def factory(key):
+        def build(mode):
+            return Backend()
+        build.cache_key = key
+        return build
+
+    monkeypatch.setattr(tool, "_cua_permission_mode", lambda sid: "standard")
+    monkeypatch.setattr(cb, "desktop_identity", lambda: "test")
+    monkeypatch.setattr(cb, "backend_display_stale", lambda old, new: False)
+    sid = "original-native-session"
+    try:
+        first = tool._get_backend(sid, backend_factory=factory(("run-a", "device-a")))
+        with tool._backend_for_call(sid, backend_factory=factory(("run-a", "device-a"))) as cached:
+            assert cached is first
+        with tool._backend_for_call(sid, backend_factory=factory(("run-a", "device-b"))) as changed:
+            assert changed is not first
+        assert stopped == [first]
+        newest = tool._get_backend(sid, backend_factory=factory(("run-b", "device-b")))
+        assert newest is not changed
+        assert stopped == [first, changed]
+        assert tool.release_computer_use_session(sid)
+        assert stopped == created
+        assert not tool.release_computer_use_session(sid)
+    finally:
+        tool.release_computer_use_session(sid)
+
+
+def test_remote_cli_never_reads_remote_file_path_locally(tmp_path):
+    local_file = tmp_path / "remote-name.png"
+    local_file.write_bytes(b"private local file")
+    result = session._cli_result({"screenshot_file_path": str(local_file)}, None, read_screenshot_file=False)
+    assert result["images"] == []
+
+
+def test_host_approval_denial_prevents_backend_and_admits_each_scope(monkeypatch):
+    from tools.bot_desktop import lease
+    approved, created = [], []
+    state = SimpleNamespace(epoch=1)
+    monkeypatch.setattr(lease, "assert_agent_may_act", lambda: state)
+    monkeypatch.setattr(lease, "get", lambda: state)
+    monkeypatch.setattr(tool, "_cua_permission_mode", lambda sid: "standard")
+    monkeypatch.setattr(cb, "desktop_identity", lambda: "test")
+    monkeypatch.setattr(cb, "backend_display_stale", lambda old, new: False)
+    monkeypatch.setattr(tool, "_dispatch", lambda *args, **kwargs: "performed")
+    monkeypatch.setattr(tool, "_request_approval", lambda *args: pytest.fail("global approval invoked"))
+
+    def factory(mode):
+        created.append(mode)
+        return tool._NoopBackend()
+
+    def allow(scope, args):
+        approved.append(scope)
+        return None
+
+    args = {"action": "click", "x": 1, "y": 2, "bring_to_front": True, "delivery_mode": "foreground"}
+    sid = "host-admitted-session"
+    try:
+        assert tool.handle_computer_use(args, backend_factory=factory, approval_gate=lambda *a: "denied",
+                                        session_id=sid) == "denied"
+        assert created == []
+        assert tool.handle_computer_use(args, backend_factory=factory, approval_gate=allow,
+                                        session_id=sid) == "performed"
+        assert approved == ["click", "bring_to_front"]
+        assert created == ["standard"]
+    finally:
+        tool.release_computer_use_session(sid)
