index 0000000000000000000000000000000000000000..86f4262fefccde8674ddc0e420fc270c4374f01e
--- /dev/null
+++ b/tests/gateway/test_api_server_run_scope.py
@@ -0,0 +1,323 @@
+"""Personal-AIOS speaker run scope (gateway/run_scope.py): a guest voice runs isolated from the owner's transcript and
+memory with chat/web/reply tools only; an uncertain owner voice keeps the owner session with the same tool allowlist."""
+import asyncio
+import json
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+from aiohttp import web
+from aiohttp.test_utils import TestClient, TestServer
+
+from gateway import run_scope
+from gateway.config import PlatformConfig
+from gateway.platforms.api_server import APIServerAdapter
+
+AUTH = {"Authorization": "Bearer test-native-key", "X-Hermes-Run-Contract": "hermes.run.v2"}
+OWNER_TOOLS = ["memory", "session_search", "phone_task", "send_message", "skill_view", "delegate_task", "terminal",
+               "web_search", "web_extract", "todo_list", "paios_open_reply", "paios_l3_query", "paios_action_request", "paios_l5_read",
+               "phone_cancel", "phone_continue", "paios_l3_commit", "future_effect_tool", "paios_health_query", "paios_terminal_question", "paios_call_offer"]
+
+
+def _tool(name):
+    return {"type": "function", "function": {"name": name, "parameters": {"type": "object", "properties": {}}}}
+
+
+def _agent():
+    agent = MagicMock()
+    agent.tools = [_tool(name) for name in OWNER_TOOLS]
+    agent.valid_tool_names = set(OWNER_TOOLS)
+    agent._memory_store = object()
+    agent.run_conversation.return_value = {"final_response": "ok"}
+    agent.session_prompt_tokens = agent.session_completion_tokens = agent.session_total_tokens = 0
+    return agent
+
+
+def _plain_agent():
+    return SimpleNamespace(tools=[_tool(name) for name in OWNER_TOOLS], valid_tool_names=set(OWNER_TOOLS), _memory_store=object(),
+                           _guardrail_block_result=None)
+
+
+def _app(adapter):
+    app = web.Application()
+    app.router.add_post("/v1/runs", adapter._handle_runs)
+    app.router.add_get("/v1/runs/{run_id}", adapter._handle_get_run)
+    return app
+
+
+async def _start(body, history=None):
+    adapter = APIServerAdapter(PlatformConfig(enabled=True, extra={"key": "test-native-key"}))
+    loaded, created = [], {}
+
+    async def conversation_history(session_id):
+        loaded.append(session_id)
+        return list((history or {}).get(session_id, []))
+
+    adapter._conversation_history_for_session = conversation_history
+    agent = _agent()
+    agent._session_db = adapter._ensure_session_db()
+
+    def create_agent(**kwargs):
+        from hermes_constants import get_hermes_home
+        created["profile_home"] = get_hermes_home()
+        from agent.secret_scope import get_secret
+        created["model_key"] = get_secret("BUILD_MODEL_KEY")
+        created["private_env"] = get_secret("OWNER_PRIVATE_DATA")
+        created.update(kwargs)
+        run_scope.restrict_agent(agent, kwargs.get("run_scope"))
+        agent.session_id = kwargs["session_id"]
+        agent._ensure_db_session.side_effect = lambda: agent._session_db.ensure_session(agent.session_id, "api_server")
+        def answer(**call):
+            created["model_history"] = call.get("conversation_history")
+            created["tool_conversation"] = getattr(agent, "_paios_tool_conversation", None)
+            db = agent._session_db
+            row = db.get_session(agent.session_id)
+            created["hidden_before_model"] = bool(row and row["hidden"])
+            created["listed_sessions"] = [row["id"] for row in db.list_sessions_rich()]
+            return {"final_response": "ok"}
+        agent.run_conversation.side_effect = answer
+        return agent
+
+    with patch.object(adapter, "_create_agent", side_effect=create_agent):
+        async with TestClient(TestServer(_app(adapter))) as client:
+            response = await client.post("/v1/runs", json=body, headers=AUTH)
+            data = await response.json()
+            if response.status == 202:
+                for _ in range(200):
+                    status = await (await client.get(f"/v1/runs/{data['run_id']}", headers=AUTH)).json()
+                    if status["status"] in {"completed", "failed", "cancelled"}:
+                        break
+                    await asyncio.sleep(0.02)
+    if response.status == 202:
+        created["terminal"] = status
+    return response.status, data, loaded, created, agent
+
+
+def test_request_scope_fields_are_validated():
+    assert run_scope.run_scope_request({"input":"x"}) == ("owner",None)
+    assert run_scope.run_scope_request({"session_id":"s","run_scope":"guest","guest_key":"speaker:12"}) == ("guest","speaker:12")
+    assert run_scope.run_scope_request({"session_id":"s","run_scope":"owner_uncertain"}) == ("owner_uncertain",None)
+    for body in [{"session_id":"s","run_scope":"admin"}, {"session_id":"s","run_scope":"guest"},
+                 {"session_id":"s","run_scope":"owner_uncertain","guest_key":"k"},
+                 {"session_id":"s","run_scope":"guest","guest_key":"../owner"}, {"run_scope":"owner_uncertain"},
+                 {"session_id":"s","run_scope":"guest","guest_key":"k","conversation_history":[{"role":"user","content":"x"}]},
+                 {"session_id":"s","run_scope":"guest","guest_key":"k","previous_response_id":"resp"}]:
+        with pytest.raises(ValueError): run_scope.run_scope_request(body)
+    guest=run_scope.guest_session_id("owner-session","speaker:12")
+    assert guest.startswith("paios-guest-") and guest != "owner-session"
+    assert guest == run_scope.guest_session_id("owner-session","speaker:12")
+    assert guest != run_scope.guest_session_id("owner-session","speaker:13")
+
+
+def test_restricted_agent_surface_and_dispatch_block():
+    agent = _plain_agent()
+    run_scope.restrict_agent(agent, "owner")
+    assert len(agent.tools) == len(OWNER_TOOLS) and run_scope.tool_block(agent, "phone_task") is None
+    run_scope.restrict_agent(agent, "guest")
+    assert agent.valid_tool_names == {"web_search", "web_extract", "paios_open_reply"}
+    assert agent._memory_store is None and agent.skip_background_review is True
+    for name in ["memory", "session_search", "phone_task", "send_message", "paios_l3_query", "paios_action_request", "terminal"]:
+        assert "not available in run_scope guest" in run_scope.tool_block(agent, name)
+    assert run_scope.tool_block(agent, "web_search") is None and run_scope.tool_block(agent, "paios_open_reply") is None
+    # A continuing session's pinned owner tools are withheld again after the pin is restored.
+    agent.tools.append(_tool("phone_task"))
+    run_scope.restrict_agent(agent, agent._paios_run_scope)
+    assert "phone_task" not in {tool["function"]["name"] for tool in agent.tools}
+
+
+@pytest.mark.parametrize("scope,name", [("owner_uncertain", "phone_task")] + [
+    (scope, name) for scope in ["guest", "owner_uncertain"] for name in ["paios_terminal_question", "paios_call_offer"]] + [
+    ("care", name) for name in ["web_search", "web_extract", "phone_task", "phone_cancel", "phone_continue", "send_message", "memory",
+                               "paios_l3_commit", "paios_action_request", "delegate_task", "terminal", "future_effect_tool",
+                               "session_search", "paios_l3_query", "paios_l3_inspect", "paios_l5_read", "paios_l5_locate",
+                               "paios_ambient_journal_search", "paios_visual_recall", "paios_people"]])
+def test_dispatch_authority_refuses_tools_outside_the_scope(scope, name):
+    from agent.tool_executor import _dispatch_authorized_once
+    agent = _plain_agent()
+    run_scope.restrict_agent(agent, scope)
+    executed = []
+    ref = SimpleNamespace(name=name, args={}, emit_post=lambda *a, **k: None)
+    state = SimpleNamespace(args={}, blocked=False)
+    result = _dispatch_authorized_once(agent, state, ref, execute=lambda args: executed.append(args), scope_block=None,
+                                       display_index=None, begin_execution=None, authorization_gate=None)
+    assert executed == [] and f"not available in run_scope {scope}" in result
+
+
+@pytest.mark.asyncio
+async def test_guest_run_gets_an_isolated_transcript_and_restricted_agent():
+    key = "speaker:12:2026-10-09"
+    status, data, loaded, created, _ = await _start(
+        {"input": "D", "instructions": "skill", "session_id": "owner-session", "run_scope": "guest", "guest_key": key},
+        history={"owner-session": [{"role": "user", "content": "owner secret"}]})
+    guest = run_scope.guest_session_id("owner-session", key)
+    assert status == 202, data
+    assert data["run_scope"] == "guest" and "memory_write" not in data
+    assert data["conversation_session_id"] == "owner-session" and data["session_id"] == guest
+    assert loaded == [guest]  # the owner's transcript is never loaded
+    assert created["run_scope"] == "guest" and created["session_id"] == guest
+    assert created["ephemeral_system_prompt"].startswith("skill") and "访客模式" in created["ephemeral_system_prompt"]
+
+
+@pytest.mark.asyncio
+async def test_uncertain_owner_isolates_history_and_keeps_controller_tool_binding():
+    body = {"input": "D", "instructions": "skill", "session_id": "owner-session",
+            "run_scope": "owner_uncertain"}
+    status, data, loaded, created, _ = await _start(body,
+        history={"owner-session": [{"role": "user", "content": "private-owner-history"}]})
+    assert status == 202, data
+    assert data["run_scope"] == "owner_uncertain" and "memory_write" not in data
+    assert data["session_id"] == "paios-uncertain-" + data["run_id"]
+    assert data["conversation_session_id"] == created["tool_conversation"] == "owner-session"
+    assert loaded == [data["session_id"]] and created["model_history"] == []
+    assert created["run_scope"] == "owner_uncertain" and "确认是我" in created["ephemeral_system_prompt"]
+    for scope in ("guest", "owner_uncertain"):
+        scoped = {**body, "run_scope": scope, **({"guest_key": "speaker:1:2026-10-11"} if scope == "guest" else {})}
+        for continuation in ({"conversation_history": [{"role": "user", "content": "private"}]},
+                             {"previous_response_id": "owner-response"}):
+            status, data, loaded, created, _ = await _start({**scoped, **continuation})
+            assert status == 400 and data["error"]["code"] == "invalid_run_scope"
+            assert loaded == [] and created == {}
+
+
+@pytest.mark.asyncio
+async def test_owner_runs_are_unchanged_and_invalid_scopes_are_refused():
+    status, data, _, created, _ = await _start({"input": "D", "instructions": "skill", "session_id": "owner-session"})
+    assert status == 202 and data["run_scope"] == "owner" and "run_scope" not in created
+    assert created["ephemeral_system_prompt"] == "skill"
+    for body in [{"input": "D", "session_id": "s", "run_scope": "guest", "guest_key": "bad key"},
+                 {"input": "D", "session_id": "s", "run_scope": "superuser"}]:
+        status, data, _, created, _ = await _start(body)
+        assert status == 400 and data["error"]["code"] == "invalid_run_scope" and created == {}
+
+
+def test_create_agent_narrows_toolsets_for_a_restricted_scope(monkeypatch):
+    created = []
+
+    class FakeAgent:
+        def __init__(self, **kwargs):
+            created.append(kwargs)
+            self.tools = [_tool(name) for name in OWNER_TOOLS]
+            self.valid_tool_names = set(OWNER_TOOLS)
+
+    monkeypatch.setattr("run_agent.AIAgent", FakeAgent)
+    monkeypatch.setattr("gateway.run._resolve_runtime_agent_kwargs", lambda: {"provider": "custom", "base_url": "http://127.0.0.1:9/v1"})
+    monkeypatch.setattr("gateway.run._resolve_gateway_model", lambda: "stub-model")
+    monkeypatch.setattr("gateway.run._load_gateway_config", lambda: {})
+    monkeypatch.setattr("gateway.run.GatewayRunner._load_reasoning_config", staticmethod(lambda model="": None))
+    monkeypatch.setattr("gateway.run.GatewayRunner._load_fallback_model", staticmethod(lambda: None))
+    monkeypatch.setattr("gateway.run._current_max_iterations", lambda: 8)
+    monkeypatch.setattr("hermes_cli.tools_config._get_platform_tools",
+                        lambda *_: {"memory", "session_search", "web", "phone", "skills", "delegation", "todo"})
+    adapter = APIServerAdapter(PlatformConfig(enabled=True))
+    monkeypatch.setattr(adapter, "_ensure_session_db", lambda: None)
+    guest = adapter._create_agent(session_id="paios-guest-x", run_scope="guest")
+    owner = adapter._create_agent(session_id="owner-session")
+    assert created[0]["enabled_toolsets"] == ["delegation", "memory", "web"]
+    assert "delegate_task" not in guest.valid_tool_names
+    assert sorted(created[1]["enabled_toolsets"]) == ["delegation", "memory", "phone", "session_search", "skills", "todo", "web"]
+    assert guest.valid_tool_names == {"web_search", "web_extract", "paios_open_reply"} and guest._paios_run_scope == "guest"
+    assert not hasattr(owner, "_paios_run_scope") and "phone_task" in owner.valid_tool_names
+
+    from hermes_constants import get_hermes_home
+    home = get_hermes_home()
+    child = home / "workshop"
