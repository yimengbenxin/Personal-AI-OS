index 0000000000000000000000000000000000000000..cc8255c6e5c11f28430adad0fcb62cc15cc42939
--- /dev/null
+++ b/tools/skill_product.py
@@ -0,0 +1,120 @@
+"""Product skills keep image authority; proposed edits belong to the release workspace."""
+import difflib
+import json
+from pathlib import Path
+from uuid import uuid4
+
+from hermes_constants import get_hermes_home
+
+
+def product_dirs():
+    from agent.skill_utils import get_external_skills_dirs
+    plugin = (get_hermes_home() / 'plugins/personal_aios').resolve()
+    return [root for root in get_external_skills_dirs() if root.resolve().is_relative_to(plugin)]
+
+
+def product_candidates(name, roots=None):
+    from tools.skills_tool import _collect_skill_candidates
+    return _collect_skill_candidates(Path(name).name, None, product_dirs() if roots is None else roots)
+
+
+def product_skill(name):
+    candidates = product_candidates(name)
+    if len(candidates) > 1:
+        raise ValueError(f"Ambiguous product skill name '{name}': {[str(p) for _, p in candidates]}")
+    return candidates[0][0] if candidates else None
+
+
+def check_local_collisions(local, roots):
+    from agent.skill_utils import iter_skill_index_files
+    from tools.skills_tool import _safe_frontmatter
+    from tools.skills_tool import _collect_skill_candidates
+    collisions = []
+    for root in roots:
+        for product in iter_skill_index_files(root, 'SKILL.md'):
+            for name in {product.parent.name, _safe_frontmatter(product).get('name', product.parent.name)}:
+                for _, path in _collect_skill_candidates(name, None, [Path(local)]):
+                    collisions.append(f"{name}: {path} -> {product}")
+    if collisions:
+        raise ValueError('SKILL_AUTHORITY_COLLISION: reconcile local skills with product authority; '
+                         'preserve local improvements as release proposals, then move or rename the local copy: '
+                         + '; '.join(sorted(set(collisions))))
+
+
+def propose(operations, *, batch=False):
+    """Return None for local learning; compose product edits without writing any skill tree."""
+    from tools import skill_manager_tool as smt
+    from tools.fuzzy_match import fuzzy_find_and_replace
+    from tools.skill_provenance import get_current_write_origin
+    targets = [product_skill(op['name']) for op in operations]
+    for op, target in zip(operations, targets):
+        if op['action'] == 'create':
+            fm, _ = smt._parse_frontmatter(op.get('content') or '')
+            if target or product_skill(str(fm.get('name', op['name']))):
+                return smt._err(f"Product skill '{op['name']}' already exists; improve it through self-release.")
+    if not any(targets):
+        return None
+    if not all(targets):
+        return smt._err('Submit product release proposals separately from local skill changes.')
+    if batch:
+        from tools.skill_manager_batch import _validate_batch_ops
+        from tools.registry import tool_error
+        canonical = [{**op, "name": target.name} for op, target in zip(operations, targets)]
+        _, error = _validate_batch_ops(canonical, None, tool_error, release_proposal=True)
+        if error:
+            return json.loads(error)
+    before, after = {}, {}
+    for op, target in zip(operations, targets):
+        action, name = op['action'], op['name']
+        if error := smt._op_shape_error(action, op):
+            return smt._err(error)
+        if action not in {'edit', 'patch', 'write_file', 'remove_file'}:
+            return smt._err('Product skills are read-only; propose an edit or patch through self-release.')
+        label = 'SKILL.md' if op.get('content') else op.get('file_path') or 'SKILL.md'
+        path, error = smt._resolve_supporting_file(target, label)
+        if error:
+            return error
+        if path.exists():
+            if error := smt._background_review_read_before_write_guard(name, path, action, label):
+                return error
+        if path not in before:
+            before[path] = path.read_text() if path.exists() else None
+            after[path] = before[path]
+        text = after[path]
+        if action == 'patch' and not op.get('content'):
+            if text is None:
+                return smt._err(f'File not found: {label}')
+            text, _, _, error = fuzzy_find_and_replace(text, op['old_string'], op['new_string'], op.get('replace_all', False))
+            if error:
+                return smt._err(error)
+        else:
+            text = {'edit': op.get('content'), 'patch': op.get('content'),
+                    'write_file': op.get('file_content'), 'remove_file': None}[action]
+        if text is not None:
+            if error := (smt._validate_content_size(text, label) or
+                         (label == 'SKILL.md' and smt._validate_frontmatter(text))):
+                return smt._err(error)
+        after[path] = text
+    plugin = (get_hermes_home() / 'plugins/personal_aios').resolve()
+    diff = []
+    for path, original in before.items():
+        relative = 'integrations/hermes/personal_aios/' + path.resolve().relative_to(plugin).as_posix()
+        diff.extend(difflib.unified_diff((original or '').splitlines(True), (after[path] or '').splitlines(True),
+                    fromfile='a/' + relative if original is not None else '/dev/null',
+                    tofile='b/' + relative if after[path] is not None else '/dev/null'))
+    if not diff:
+        return smt._err('Product skill proposal contains no change.')
+    request_id = uuid4().hex[:12]
+    workspace = get_hermes_home() / 'release-workspace/skill-proposals'
+    workspace.mkdir(parents=True, exist_ok=True)
+    partial = workspace / ('.' + request_id)
+    partial.mkdir()
+    patch = ''.join(line if line.endswith('\n') else line + '\n\\ No newline at end of file\n' for line in diff)
+    (partial / 'candidate.patch').write_text(patch)
+    (partial / 'reason.json').write_text(json.dumps({'reason': 'product_skill_improvement',
+        'origin': get_current_write_origin(), 'skills': sorted({op['name'] for op in operations}),
+        'actions': [op['action'] for op in operations]}, ensure_ascii=False) + '\n')
+    candidate = workspace / request_id
+    partial.rename(candidate)
+    return {'success': True, 'release_candidate': str(candidate / 'candidate.patch'), 'patch': patch, 'applied': False,
+            'message': '已保存产品技能改进候选，请将补丁正文交给 repair，按 self-release 测试、预发后发布。'}
