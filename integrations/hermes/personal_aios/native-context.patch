+"""Direct MiMo budgets follow its documented Chat Completions protocol.
+
+https://mimo.mi.com/docs/en-US/api/chat/openai-api
+No credentials, network requests, or agent turn execution are needed.
+"""
+
+import json
+
+from openai import OpenAI
+from openai._models import FinalRequestOptions
+import pytest
+
+from agent.transports.chat_completions import ChatCompletionsTransport
+from run_agent import AIAgent
+from utils import base_url_hostname
+
+
+def _agent(url, model):
+    agent = AIAgent.__new__(AIAgent)
+    agent.base_url = url
+    agent.model = model
+    agent._base_url_lower = url.lower()
+    agent._base_url_hostname = base_url_hostname(url)
+    return agent
+
+
+@pytest.mark.parametrize("url, model, key", [
+    ("https://api.xiaomimimo.com/v1", "mimo-v2.6-pro", "max_completion_tokens"),
+    ("https://API.XIAOMIMIMO.COM:443/v1", "mimo-v2.6-pro", "max_completion_tokens"),
+    ("https://api.xiaomimimo.com/v1", "other-model", "max_completion_tokens"),
+    ("https://api.xiaomimimo.com.evil.test/v1", "mimo-v2.6-pro", "max_tokens"),
+    ("https://notapi.xiaomimimo.com/v1", "mimo-v2.6-pro", "max_tokens"),
+    ("https://other.test/api.xiaomimimo.com/v1", "mimo-v2.6-pro", "max_tokens"),
+    ("https://api.xiaomimimo.com@other.test/v1", "mimo-v2.6-pro", "max_tokens"),
+    ("https://api.deepseek.com/v1", "deepseek-flash", "max_tokens"),
+    ("https://openrouter.ai/api/v1", "xiaomi/mimo-v2.6-pro", "max_tokens"),
+    ("https://api.openai.com/v1", "gpt-5", "max_completion_tokens"),
+    ("https://other.test/v1", "gpt-5", "max_completion_tokens"),
+])
+def test_budget_protocol_is_host_scoped_and_preserves_existing_routes(url, model, key):
+    assert _agent(url, model)._max_tokens_param(2048) == {key: 2048}
+
+
+@pytest.mark.parametrize("recovery, expected", [(None, 2048), (8192, 8192)])
