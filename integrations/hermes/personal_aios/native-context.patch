index 0000000000000000000000000000000000000000..9f61750fb5c53027dcca76f6c227a5a73c6db5b8
--- /dev/null
+++ b/tools/personal_aios_task_outcome.py
@@ -0,0 +1,50 @@
+"""The product's delegated result contract, separate from a native loop's completion."""
+import json
+
+CONTRACT = "paios.task-outcome.v1"
+
+
+def task_outcome_schema(result_schema=None):
+    schema = {
+        "$id": CONTRACT, "type": "object", "additionalProperties": False,
+        "required": ["outcome", "reason", "summary"],
+        "properties": {
+            "outcome": {"enum": ["succeeded", "partial", "failed", "cancelled"],
+                        "description": "Report this delegated stage's verified outcome from actual tool receipts. succeeded requires every stage goal completed; partial means some work remains stopped, blocked or unverified; failed means no goal completed; cancelled means the owner cancelled."},
+            "reason": {"type": "string", "maxLength": 96, "pattern": r"^[^\r\n]*$",
+                       "description": "A short public reason in the owner's language: what finished and what remains. No paths or secrets. Empty only for succeeded."},
+            "summary": {"type": "string", "minLength": 1},
+        },
+        "allOf": [{
+            "if": {"properties": {"outcome": {"const": "succeeded"}}},
+            "then": {"properties": {"reason": {"maxLength": 0}}},
+            "else": {"properties": {"reason": {"minLength": 1, "pattern": r"\S"}}},
+        }],
+    }
+    if result_schema is not None:
+        schema["properties"]["result"] = {"$id": "urn:paios:task-result.v1", **result_schema}
+        schema["required"].append("result")
+    return schema
+
+
+def task_outcome_entry(entry, schema, task=None):
+    """Only a validated report can claim success; retain verified partial work and native cancellation."""
+    if not isinstance(schema.schema, dict) or schema.schema.get("$id") != CONTRACT:
+        return
+    if task is not None:
+        entry["task"] = task
+    from tools.delegation_output_schema import extract_json_candidate
+    report = json.loads(extract_json_candidate(entry["summary"])) if schema.valid is True else None
+    if entry.get("cancelled_by_user"):
+        outcome, reason = "cancelled", "任务已中断"
+    elif report is not None and report["outcome"] != "succeeded":
+        outcome, reason = report["outcome"], report["reason"]
+    elif entry["status"] != "completed":
+        outcome, reason = "failed", "任务已中断，完成情况待核对" if entry["status"] == "interrupted" else "任务执行失败，完成情况待核对"
+    elif entry["exit_reason"] != "completed":
+        outcome, reason = "partial", "达到工具调用上限，任务未完成"
+    elif report is None:
+        outcome, reason = "failed", "结果未通过核验，完成情况待核对"
+    else:
+        outcome, reason = report["outcome"], report["reason"]
+    entry.update(outcome=outcome, outcome_reason=reason)
