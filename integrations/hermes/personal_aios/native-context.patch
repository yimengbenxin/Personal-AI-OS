new file mode 100644
index 0000000000000000000000000000000000000000..f314d14889143b73a97ff41f61d306f6de5ae65c
--- /dev/null
+++ b/tools/computer_use/cua_backend_transport.py
@@ -0,0 +1,50 @@
+"""Instance-owned command transport for a driver hosted outside this machine."""
+from __future__ import annotations
+
+import os
+from types import MappingProxyType
+from typing import Any, Mapping
+
+
+class DriverTransport:
+    """Snapshot host-supplied command arguments without changing process environment."""
+
+    def __init__(self, spec: Mapping[str, Any]) -> None:
+        command, args, env = spec["command"], spec["args"], spec["env"]
+        if not isinstance(command, str) or not os.path.isabs(command):
+            raise ValueError("driver_transport.command must be an absolute local wrapper path")
+        if not isinstance(args, (list, tuple)) or not all(isinstance(v, str) for v in args):
+            raise ValueError("driver_transport.args must contain strings")
+        if not isinstance(env, Mapping) or not all(isinstance(k, str) and isinstance(v, str) for k, v in env.items()):
+            raise ValueError("driver_transport.env must map strings to strings")
+        self.spec = MappingProxyType({"command": command, "args": tuple(args), "env": MappingProxyType(dict(env))})
+
+    def argv(self, *args: str) -> list[str]:
+        return [self.spec["command"], *self.spec["args"], *args]
+
+    def child_env(self) -> dict[str, str]:
+        from tools.computer_use.cua_backend import cua_driver_child_env
+        from tools.environments.local import _sanitize_subprocess_env
+        return _sanitize_subprocess_env({**cua_driver_child_env(), **self.spec["env"]})
+
+    def run(self, *args: str, timeout: float) -> Any:
+        from tools.computer_use.cua_backend import _run_quiet
+        from hermes_cli._subprocess_compat import windows_hide_flags
+        return _run_quiet(self.argv(*args), timeout=timeout, encoding="utf-8", errors="replace",
+                          creationflags=windows_hide_flags(), env=self.child_env())
+
+    def mcp_invocation(self) -> tuple[str, list[str]]:
+        from tools.computer_use import cua_backend_driver as driver
+        from tools.computer_use.cua_backend import _cua_no_overlay
+        result = self.run("manifest", timeout=6.0)
+        manifest = driver._json_object(result.stdout or "") if result.returncode == 0 else None
+        reason = driver._manifest_contract_reason(manifest)
+        if reason:
+            raise RuntimeError(f"cua-driver is not ready: {reason}")
+        args = driver._valid_mcp_args(manifest["mcp_invocation"])
+        if _cua_no_overlay():
+            help_result = self.run("--help", timeout=3.0)
+            if "--no-overlay" in (help_result.stdout or "") + (help_result.stderr or ""):
+                args = [*args, "--no-overlay"]
+        # The manifest's executable belongs to the remote host. All verbs must retain this wrapper.
+        return self.spec["command"], [*self.spec["args"], *args]
