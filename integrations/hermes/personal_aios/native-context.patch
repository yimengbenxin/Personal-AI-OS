@@ -0,0 +1,142 @@
+"""Spilled owner results remain readable without the workshop seeing their bytes."""
+import json
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import pytest
+
+import tools.file_tools  # registers the real read/search handlers
+from tools.registry import registry
+from tools.tool_result_storage import (
+    extract_persisted_path, get_spillover_dir, maybe_persist_tool_result,
+)
+
+
+@pytest.mark.parametrize("persist_before_terminal,isolated", [(False, False), (True, False), (False, True)])
+def test_remote_spill_can_be_paged_and_searched_without_transfer(monkeypatch, tmp_path,
+                                                              persist_before_terminal, isolated):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "owner"))
+    env = MagicMock(isolated=isolated)
+    env.execute.side_effect = AssertionError("owner spill must never reach workshop")
+    content = "".join(f"owner-result-{i:05d}\n" for i in range(12000))
+    message = maybe_persist_tool_result(content, "web_fetch", "large_web",
+                                        env=None if persist_before_terminal else env, threshold=30000)
+    path = extract_persisted_path(message)
+    assert path == str(get_spillover_dir() / "large_web.txt")
+    assert Path(path).read_text() == content
+
+    # A terminal that starts later is just as remote. Host reads must not create/use it.
+    from tools.file_operations_common import ReadResult, SearchResult
+    remote_ops = MagicMock(env=env)
+    remote_ops.read_file.return_value = ReadResult(error=f"File not found: {path}")
+    remote_ops.search.return_value = SearchResult(error=f"Path not found: {path}")
+    get_remote_ops = MagicMock(return_value=remote_ops)
+    monkeypatch.setattr(tools.file_tools, "_get_file_ops", get_remote_ops)
+    for offset in (1, 7000):
+        page = json.loads(registry.dispatch("read_file", {"path": path, "offset": offset, "limit": 2},
+                                            task_id=f"spill-{offset}"))
+        assert not page.get("error"), page
+        assert f"owner-result-{offset - 1:05d}" in page["content"]
+        assert f"owner-result-{offset:05d}" in page["content"]
+        assert f"owner-result-{offset + 1:05d}" not in page["content"]
+    for search_path in (path, str(get_spillover_dir())):
+        hits = json.loads(registry.dispatch("search_files", {
+            "path": search_path, "pattern": "owner-result-07000", "limit": 2}, task_id="spill-search"))
+        assert not hits.get("error"), hits
+        assert "owner-result-07000" in json.dumps(hits)
+    assert "execute_code" not in message
+    get_remote_ops.assert_not_called()
+    env.execute.assert_not_called()
+    env._sync_manager.sync.assert_not_called()
+
+    from tools.environments.file_sync import iter_sync_files
+    assert not any(source == path for source, _ in iter_sync_files(include_credentials=False))
+    assert not any(source == path for source, _ in iter_sync_files(isolated=True))
+
+
+def test_host_read_route_does_not_open_other_paths_or_write_spills(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "owner"))
+    root = get_spillover_dir()
+    root.mkdir(parents=True)
+    outside = tmp_path / "outside.txt"
+    outside.write_text("private outside spillover")
+    (root / "escape.txt").symlink_to(outside)
+    sibling = root.with_name("spillover-other")
+    sibling.mkdir()
+    remote = MagicMock(side_effect=RuntimeError("remote backend only"))
+    monkeypatch.setattr(tools.file_tools, "_get_file_ops", remote)
+    for path in (outside, root / "escape.txt", root / ".." / outside.name, sibling):
+        for name, args in (("read_file", {}), ("search_files", {"pattern": "private"})):
+            result = json.loads(registry.dispatch(name, {"path": str(path), **args}, task_id="spill-boundary"))
+            assert "remote backend only" in result["error"]
+    spill = root / "result.txt"
+    spill.write_text("original result")
+    result = json.loads(registry.dispatch("write_file", {"path": str(spill), "content": "overwrite"}))
+    assert result.get("error")
+    assert "read-only" in result["error"]
+    assert spill.read_text() == "original result"
+    result = json.loads(registry.dispatch("patch", {
+        "path": str(spill), "old_string": "original", "new_string": "changed"}))
+    assert "read-only" in result["error"]
+    assert spill.read_text() == "original result"
+
+
+@pytest.mark.parametrize("engine", ["rg", "grep"])
+def test_single_line_spill_is_readable_beyond_the_normal_line_clamp(monkeypatch, tmp_path, engine):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "owner"))
+    if engine == "grep":
+        from tools.file_operations import ShellFileOperations
+        has_command = ShellFileOperations._has_command
+        monkeypatch.setattr(ShellFileOperations, "_has_command",
+                            lambda self, name: False if name == "rg" else has_command(self, name))
+    content = "x" * 6000 + "middle-of-single-line" + "y" * 60000
+    message = maybe_persist_tool_result(content, "tool_call", "single-line", threshold=30000)
+    path = extract_persisted_path(message)
+    remote = MagicMock(side_effect=RuntimeError("workshop cannot see spillover"))
+    monkeypatch.setattr(tools.file_tools, "_get_file_ops", remote)
+    page = json.loads(registry.dispatch("read_file", {"path": path, "offset": 4, "limit": 1},
+                                        task_id="single-line"))
+    assert "middle-of-single-line" in page["content"]
+    assert page["truncated"]
+    tail = json.loads(registry.dispatch("read_file", {"path": path, "offset": page["total_lines"], "limit": 1},
+                                        task_id="single-line-tail"))
+    assert "y" in tail["content"]
+    assert not tail["truncated"]
+    for search_path in (path, str(Path(path).parent)):
+        hits = json.loads(registry.dispatch("search_files", {
+            "path": search_path, "pattern": "middle-of-single-line"}, task_id="single-line-search"))
+        match = hits["matches"][0]
+        assert match["path"] == path
+        assert match["line"] == 4
+        found = json.loads(registry.dispatch("read_file", {
+            "path": match["path"], "offset": match["line"], "limit": 1}, task_id=str(search_path)))
+        assert "middle-of-single-line" in found["content"]
+    assert Path(path).read_text() == content
+    remote.assert_not_called()
+
+    # A match crossing a display-row boundary must retain its real location.
+    unicode_content = "依" * 1995 + "cross-boundary-needle" + "米" * 60000
+    crossing = extract_persisted_path(maybe_persist_tool_result(
+        unicode_content, "tool_call", "crossing", threshold=30000))
+    hits = json.loads(registry.dispatch("search_files", {
+        "path": crossing, "pattern": "cross-boundary-needle"}, task_id="crossing"))
+    assert hits["matches"][0]["line"] == 1
+    assert hits["matches"][0]["content"] == "cross-boundary-needle"
+
+    context_path = extract_persisted_path(maybe_persist_tool_result(
+        "before\n\nneedle\nafter\n", "tool_call", "with-context", threshold=0))
+    hits = json.loads(registry.dispatch("search_files", {
+        "path": context_path, "pattern": "needle", "context": 1}, task_id="context"))
+    assert [(match["line"], match["content"]) for match in hits["matches"]] == [
+        (2, ""), (3, "needle"), (4, "after")]
+    numeric_context = extract_persisted_path(maybe_persist_tool_result(
+        "needle\n123-after\n", "tool_call", "numeric-context", threshold=0))
+    hits = json.loads(registry.dispatch("search_files", {
+        "path": numeric_context, "pattern": "needle", "context": 1}, task_id="numeric-context"))
+    assert [(match["path"], match["line"], match["content"]) for match in hits["matches"]] == [
+        (numeric_context, 1, "needle"), (numeric_context, 2, "123-after")]
+    separator = extract_persisted_path(maybe_persist_tool_result(
+        "before\u2028needle\n", "tool_call", "unicode-separator", threshold=0))
+    hits = json.loads(registry.dispatch("search_files", {
+        "path": separator, "pattern": ".*needle"}, task_id="unicode-separator"))
+    assert hits["matches"][0]["content"] == "before\u2028needle"
