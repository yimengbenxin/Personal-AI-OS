--- /dev/null
+++ b/agent/tool_call_budget.py
@@ -0,0 +1,55 @@
+"""One tool-invocation budget, including rejected attempts, per task and its nested delegates."""
+import threading
+
+
+class ToolCallBudget:
+    def __init__(self, maximum, milestone_interval=0):
+        if type(maximum) is not int or maximum < 1:
+            raise ValueError("agent.max_tool_calls must be a positive integer")
+        if type(milestone_interval) is not int or milestone_interval < 0:
+            raise ValueError("agent.tool_call_milestone_interval must be a nonnegative integer")
+        self.maximum = maximum
+        self.interval = milestone_interval
+        self.used = 0
+        self._lock = threading.Lock()
+
+    def consume(self):
+        with self._lock:
+            if self.used >= self.maximum:
+                return None
+            self.used += 1
+            return self.used
+
+
+def claim_tool_call(agent):
+    budget = getattr(agent, "tool_call_budget", None)
+    if budget is None:
+        return None
+    number = budget.consume()
+    if number is None:
+        return f"Task tool-call cap reached ({budget.used}/{budget.maximum}); stop tools and report progress and blockers."
+    if budget.interval and number % budget.interval == 0:
+        with budget._lock:
+            agent._tool_call_milestones = getattr(agent, "_tool_call_milestones", []) + [number]
+    return None
+
+
+def inject_milestones(agent, messages):
+    budget = getattr(agent, "tool_call_budget", None)
+    if budget is None:
+        return
+    with budget._lock:
+        marks = getattr(agent, "_tool_call_milestones", [])
+        agent._tool_call_milestones = []
+    if not marks:
+        return
+    messages.append({"role": "system", "content":
+        f"Tool-call milestone {marks} (task cap {agent.tool_call_budget.maximum}). "
+        "Check the original goal and new evidence. State completed work, remaining work, and blockers. "
+        "Continue only with a concrete next step that advances the goal; re-plan or ask for the missing input when stalled."})
+
+
+def count_validation_rejections(agent, calls):
+    """Validation refuses these before the native dispatch middleware can count them."""
+    for _ in calls:
+        claim_tool_call(agent)
