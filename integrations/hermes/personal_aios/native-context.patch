+def test_owner_action_grants_withheld_and_dispatch_refuses_forced_calls():
+    config = {"personal_aios": {"grantable_toolsets": ["desktop", "terminal", "file"]}}
+    names = ["terminal", "process_manage", "read_file", "write_file", "mcp__desktop__find_files", "web_search"]
+    agent = SimpleNamespace(tools=[_tool(name) for name in names])
+    run_scope.bind_action_grants(agent, [], config)
+    run_scope.restrict_agent(agent, "owner")
+    assert agent.valid_tool_names == {"web_search"}
+    for name in names[:-1]:
+        from agent.tool_executor import _dispatch_authorized_once
+        executed = []
+        agent._guardrail_block_result = None
+        ref = SimpleNamespace(name=name, args={}, emit_post=lambda *a, **k: None)
+        state = SimpleNamespace(args={}, blocked=False)
+        result = _dispatch_authorized_once(agent, state, ref, execute=lambda args: executed.append(args), scope_block=None,
+                                          display_index=None, begin_execution=None, authorization_gate=None)
+        assert executed == [] and "requires an owner action grant" in result
+    run_scope.bind_action_grants(agent, ["desktop", "terminal", "file"], config)
+    agent.tools = [_tool(name) for name in names]
+    run_scope.restrict_agent(agent, "owner")
+    assert agent.valid_tool_names == set(names)
+    assert all(run_scope.tool_block(agent, name) is None for name in names)
+    for scope in ["care", "guest", "owner_uncertain", "build"]:
+        with pytest.raises(ValueError):
+            run_scope.action_grants({"grant_toolsets": ["desktop"]}, scope, config)
+    with pytest.raises(ValueError):
+        run_scope.action_grants({"grant_toolsets": ["browser"]}, "owner", config)
