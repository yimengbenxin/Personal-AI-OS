+"""Nested tool invocation through the native execution policy."""
+import uuid
+from contextvars import ContextVar
+
+current_tool_call = ContextVar("native_tool_call", default=None)
+
+current_dispatch = ContextVar("native_nested_dispatch", default=None)
+
+
+def dispatch_nested_tool(name, args, **kwargs):
+    from agent.tool_executor import _run_agent_tool_execution_middleware
+    bound = current_dispatch.get()
+    if bound is None:
+        raise RuntimeError("Nested tool requires an active native dispatch")
+    agent, task_id = bound
+    call_id = "nested-" + uuid.uuid4().hex
+    return _run_agent_tool_execution_middleware(
+        agent, function_name=name, function_args=args, effective_task_id=task_id, tool_call_id=call_id,
+        execute=lambda final: agent._invoke_tool(name, final, task_id, tool_call_id=call_id,
+            pre_tool_block_checked=True, skip_tool_request_middleware=True, skip_tool_execution_middleware=True),
+    ).result
