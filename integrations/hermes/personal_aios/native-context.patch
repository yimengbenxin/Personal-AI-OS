+@pytest.mark.skipif(os.name != 'posix', reason='process-group cleanup is POSIX-specific')
+def test_concurrent_sdk_spawns_and_unrelated_child_keep_exact_owners():
+    mcp_tool._ensure_mcp_sdk()
+    from mcp.client import stdio
+    lifecycle._install_stdio_spawn_tracking()
+    factory = stdio._create_platform_compatible_process
+    lifecycle._install_stdio_spawn_tracking()
+    assert stdio._create_platform_compatible_process is factory
+    command = [sys.executable, '-B', '-c', 'import time; time.sleep(60)']
+
+    async def run():
+        entered = [asyncio.Event(), asyncio.Event()]
+        release = asyncio.Event()
+        processes = []
+        captures = [set(), set()]
+        owners = [mcp_tool.MCPServerTask('healthy'), mcp_tool.MCPServerTask('failed')]
+
+        async def spawn(index):
+            token = lifecycle._stdio_spawn_pids.set((asyncio.current_task(), captures[index]))
+            try:
+                entered[index].set()
+                await release.wait()
+                process = await factory(command=command[0], args=command[1:],
+                    env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'}, errlog=subprocess.DEVNULL)
+                processes.append(process)
+                await asyncio.sleep(0)
+                assert captures[index] == {process.pid}
+                # SDK pipe/callback tasks inherit context, but cannot inherit child ownership.
+                nested = await asyncio.create_task(factory(command=command[0], args=command[1:],
+                    env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'}, errlog=subprocess.DEVNULL))
+                processes.append(nested)
+                assert captures[index] == {process.pid}
+                owners[index]._track_spawned_children(captures[index])
+                return process
+            finally:
+                lifecycle._stdio_spawn_pids.reset(token)
+
+        tasks = [asyncio.create_task(spawn(i)) for i in range(2)]
+        unrelated = None
+        try:
+            await asyncio.gather(*(event.wait() for event in entered))
+            unrelated = subprocess.Popen(command, env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'},
+                                         start_new_session=True)
+            release.set()
+            healthy, failed = await asyncio.gather(*tasks)
+            assert lifecycle._stdio_spawn_pids.get() is None
+            assert captures == [{healthy.pid}, {failed.pid}]
+            assert unrelated.pid not in lifecycle._stdio_pids
+            assert lifecycle._stdio_pids[healthy.pid] == 'healthy'
+            assert lifecycle._stdio_pids[failed.pid] == 'failed'
+            # Failed SDK teardown leaves only its own live process for the next sweep.
+            owners[1]._release_spawned_children(captures[1])
+            assert failed.pid in lifecycle._orphan_stdio_pids
+            assert healthy.pid not in lifecycle._orphan_stdio_pids
+            await asyncio.to_thread(lifecycle._kill_orphaned_mcp_children)
+            await asyncio.wait_for(failed.wait(), 5)
+            assert healthy.returncode is None
+            assert unrelated.poll() is None
+            assert lifecycle._stdio_pids[healthy.pid] == 'healthy'
+        finally:
+            for task in tasks:
+                if not task.done():
+                    task.cancel()
+            await asyncio.gather(*tasks, return_exceptions=True)
+            for process in processes:
+                if process.returncode is None:
+                    process.kill()
+                await process.wait()
+                await process.aclose()
+            for owner, captured in zip(owners, captures):
+                owner._release_spawned_children(captured)
+            if unrelated is not None:
+                unrelated.kill()
+                unrelated.wait(timeout=5)
+
+    # SDK hooks remain usable across event-loop lifecycles.
+    with patch.object(mcp_tool, '_update_death_supervisor'):
+        asyncio.run(run())
+        asyncio.run(run())
