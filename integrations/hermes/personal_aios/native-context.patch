@@ -0,0 +1,205 @@
+"""Actual native HTTP body await/control race; no model/provider requests."""
+import asyncio
+import json
+import threading
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import pytest
+from aiohttp.test_utils import TestClient, TestServer
+
+from agent.interrupt_control import InterruptControlMixin
+from gateway.platforms import api_server_runs, api_server
+from tests.gateway.test_api_server_runs import _make_adapter, _create_runs_app
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('transition', ['completed', 'stopping', 'replaced', 'scope', 'key', 'normal'])
+async def test_native_http_slow_body_rechecks_live_owner(transition, monkeypatch):
+    adapter = _make_adapter('fixture-only-key')
+    ready, finish = threading.Event(), threading.Event()
+    agent = MagicMock()
+    agent.session_id = 'fixture-native-session'
+    agent._pending_steer_lock = threading.Lock()
+    agent._pending_steer = None
+    agent.steer = InterruptControlMixin.steer.__get__(agent)
+    def controlled_turn(**kwargs):
+        ready.set()
+        assert finish.wait(10), 'test-owned worker not released'
+        return {'final_response': 'fixture completed', 'completed': True}
+    agent.run_conversation.side_effect = controlled_turn
+    monkeypatch.setattr(adapter, '_create_agent', lambda **kwargs: agent)
+    entered, release = asyncio.Event(), asyncio.Event()
+    original_read = adapter._read_json_body
+    async def observe_read(request):
+        entered.set()
+        return await original_read(request)
+    monkeypatch.setattr(adapter, '_read_json_body', observe_read)
+    async def slow_bytes():
+        yield b'{"input":'
+        await release.wait()
+        yield b'"late exact revision"}'
+    headers = {'Authorization': 'Bearer fixture-only-key'}
+    task = None
+    async with TestClient(TestServer(_create_runs_app(adapter))) as client:
+        try:
+            start = await client.post('/v1/runs', json={'input': 'controlled turn'}, headers={**headers, 'Idempotency-Key': 'fixture-run'})
+            assert start.status == 202, await start.text()
+            run_id = (await start.json())['run_id']
+            worker_task = adapter._active_run_tasks[run_id]
+            for _ in range(200):
+                if ready.is_set(): break
+                await asyncio.sleep(.005)
+            assert ready.is_set()
+            task = asyncio.create_task(client.post(f'/v1/runs/{run_id}/steer', data=slow_bytes(), headers=headers))
+            await asyncio.wait_for(entered.wait(), 3)
+            replacement = None
+            if transition == 'completed':
+                finish.set()
+                await asyncio.wait_for(asyncio.shield(worker_task), 3)
+                assert run_id not in adapter._active_run_agents
+            elif transition == 'stopping':
+                response = await client.post(f'/v1/runs/{run_id}/stop', headers=headers)
+                assert response.status == 200
+            elif transition == 'replaced':
+                replacement = MagicMock()
+                replacement.steer.return_value = True
+                adapter._active_run_agents[run_id] = replacement
+            elif transition == 'scope':
+                adapter._run_owners[run_id] = 'expired-or-foreign-scope'
+            elif transition == 'key':
+                adapter._api_key = 'changed-fixture-key'
+            release.set()
+            response = await asyncio.wait_for(task, 3)
+            body = await response.json()
+            expected = 200 if transition == 'normal' else 404 if transition == 'scope' else 401 if transition == 'key' else 409
+            observations = {'transition':transition, 'http_status':response.status, 'body':body,
+                'run_status':dict(adapter._run_statuses[run_id]), 'pending_steer':agent._pending_steer}
+            root = Path(__file__).resolve().parents[3]
+            if (root/'PRIVATE-MIRROR-MANIFEST.json').exists():
+                (root/'evidence'/('http-'+transition+'.json')).write_text(json.dumps(observations, indent=2)+'\n')
+            assert response.status == expected, observations
+            assert agent._pending_steer == ('late exact revision' if transition == 'normal' else None)
+            if replacement: replacement.steer.assert_not_called()
+            if transition == 'completed':
+                assert adapter._run_statuses[run_id]['status'] == 'completed'
+                durable = adapter._run_idempotency_store.status_for_run(adapter._run_owners[run_id], run_id)
+                assert durable['status']['status'] == 'completed'
+                adapter._run_statuses.pop(run_id)
+                get = await client.get(f'/v1/runs/{run_id}', headers=headers)
+                assert get.status == 200
+                assert (await get.json())['status'] == 'completed'
+            elif transition == 'stopping':
+                assert adapter._run_statuses[run_id]['status'] == 'stopping'
+        finally:
+            release.set(); finish.set()
+            if task and not task.done(): await task
+            if 'worker_task' in locals(): await asyncio.wait_for(asyncio.shield(worker_task), 3)
+            adapter._run_idempotency_store.close()
+            if adapter._session_db is not None: adapter._session_db.close()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('kind', ['tool', 'approval'])
+@pytest.mark.parametrize('state', ['running', 'stopping', 'completed', 'interrupted', 'forgotten'])
+async def test_worker_publication_is_owned_by_original_loop(kind, state):
+    from types import SimpleNamespace
+    adapter = _make_adapter()
+    loop = asyncio.get_running_loop()
+    queue = adapter._run_streams['fixture'] = asyncio.Queue()
+    adapter._set_run_status('fixture', 'running')
+    run = SimpleNamespace(run_id='fixture', queue=queue,
+        put_event=lambda event: queue.put_nowait(event) if adapter._run_streams.get('fixture') is queue else None)
+    callback = (adapter._make_run_event_callback('fixture', loop) if kind == 'tool'
+        else api_server_runs._make_approval_notify(adapter, run, _api_server=api_server))
+    scheduled, finish = threading.Event(), threading.Event()
+    def publish():
+        if kind == 'tool': callback('tool.started', 'fixture-tool')
+        else: callback({'request_id':'fixture-exact-approval', 'command':'fixture-command'})
+        scheduled.set()
+        finish.wait(3)
+    worker = threading.Thread(target=publish)
+    worker.start()
+    try:
+        # Do not yield: worker may enqueue but must never mutate loop-owned status.
+        assert scheduled.wait(3)
+        assert adapter._run_statuses['fixture']['status'] == 'running'
+        assert 'last_event' not in adapter._run_statuses['fixture']
+        if state == 'forgotten':
+            adapter._run_statuses.pop('fixture')
+            adapter._run_streams.pop('fixture')
+        else:
+            adapter._set_run_status('fixture', state)
+        await asyncio.sleep(0)
+        if state == 'forgotten':
+            assert 'fixture' not in adapter._run_statuses
+            assert queue.empty()
+        else:
+            expected = 'waiting_for_approval' if kind == 'approval' and state == 'running' else state
+            assert adapter._run_statuses['fixture']['status'] == expected
+            assert queue.empty() == (state in {'completed', 'interrupted'} or (kind == 'approval' and state == 'stopping'))
+        if kind == 'approval' and state == 'running':
+            api_server_runs._mark_run_event(adapter, 'fixture', 'approval.responded', request_id='fixture-exact-approval', resolved=1)
+            assert adapter._run_statuses['fixture']['status'] == 'running'
+            assert [queue.get_nowait()['event'], queue.get_nowait()['event']] == ['approval.request', 'approval.responded']
+    finally:
+        finish.set(); worker.join(3)
+        assert not worker.is_alive()
+        adapter._run_idempotency_store.close()
+
+
+@pytest.mark.parametrize('kind', ['tool', 'approval'])
+def test_closed_original_loop_publication_is_visible_failure(kind):
+    from types import SimpleNamespace
+    adapter = _make_adapter()
+    loop = asyncio.new_event_loop()
+    queue = adapter._run_streams['fixture'] = asyncio.Queue()
+    adapter._set_run_status('fixture', 'running')
+    async def create_callback():
+        run = SimpleNamespace(run_id='fixture', queue=queue, put_event=queue.put_nowait)
+        return (adapter._make_run_event_callback('fixture', loop) if kind == 'tool'
+            else api_server_runs._make_approval_notify(adapter, run, _api_server=api_server))
+    callback = loop.run_until_complete(create_callback())
+    loop.close()
+    try:
+        with pytest.raises(RuntimeError, match='closed'):
+            if kind == 'tool': callback('tool.started', 'fixture-tool')
+            else: callback({'request_id':'fixture-request'})
+        assert adapter._run_statuses['fixture']['status'] == 'running'
+        assert queue.empty()
+    finally: adapter._run_idempotency_store.close()
+
+
+@pytest.mark.parametrize('state', ['completed', 'stopping'])
+def test_control_event_does_not_reopen_terminal_or_stop(state):
+    adapter = _make_adapter()
+    queue = adapter._run_streams['fixture'] = asyncio.Queue()
+    adapter._set_run_status('fixture', state, last_event='run.'+state)
+    try:
+        api_server_runs._mark_run_event(adapter, 'fixture', 'approval.responded', resolved=1)
+        assert adapter._run_statuses['fixture']['status'] == state
+        assert adapter._run_statuses['fixture']['last_event'] == 'run.'+state
+        assert queue.empty()
+    finally: adapter._run_idempotency_store.close()
+
+
+@pytest.mark.asyncio
+async def test_loop_publication_failure_reaches_loop_exception_handler(monkeypatch):
+    adapter = _make_adapter()
+    loop = asyncio.get_running_loop()
+    errors, seen = [], asyncio.Event()
+    previous = loop.get_exception_handler()
+    def record(owner, context):
+        errors.append(context['exception']); seen.set()
+    loop.set_exception_handler(record)
+    adapter._set_run_status('fixture', 'running')
+    callback = adapter._make_run_event_callback('fixture', loop)
+    def fail(*a, **k): raise OSError('fixture status publication failed')
+    monkeypatch.setattr(adapter, '_set_run_status', fail)
+    try:
+        await asyncio.to_thread(callback, 'tool.started', 'fixture-tool')
+        await asyncio.wait_for(seen.wait(), 3)
+        assert len(errors) == 1 and str(errors[0]) == 'fixture status publication failed'
+    finally:
+        loop.set_exception_handler(previous)
+        adapter._run_idempotency_store.close()
