+"""Route a phone result into its running selfcheck's native steering inbox."""
+import json
+
+from aiohttp import web
+
+from gateway.platforms.api_run_amendment import amend
+from gateway.platforms.api_server_room_grants import _json_error
+
+
+async def handle_selfcheck_result(self, request, *, _api_server):
+    if self._room_grant_token(request):
+        return _json_error(_api_server._openai_error, "Service authentication required.",
+                           code="service_auth_required", status=403)
+    error = self._check_auth(request)
+    if error is not None:
+        return error
+    body, error = await self._read_json_body(request)
+    if error is not None:
+        return error
+    result = body.get("result")
+    if not isinstance(result, dict) or any(
+        not isinstance(result.get(key), str) or not result[key].strip()
+        for key in ("principal_id", "job_id", "self_check_of")
+    ):
+        return _json_error(_api_server._openai_error,
+                           "result requires principal_id, job_id and self_check_of strings.",
+                           code="invalid_selfcheck_result", status=400)
+    principal, marker = result["principal_id"], result["self_check_of"]
+    text = json.dumps({"kind": "selfcheck_result", "result": result},
+                      ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+
+    def deliver():
+        from tools.delegate_tool_registry import (
+            _active_subagents, _active_subagents_lock, steer_subagent)
+        with _active_subagents_lock:
+            owners = [(record["depth"], sid) for sid, record in _active_subagents.items()
+                      if getattr(record.get("agent"), "_self_check_of", None) == marker
+                      and getattr(record.get("agent"), "_paios_principal_id", None) == principal]
+        if not owners:
+            return {"error": "run_not_accepting_steer"}
+        _, sid = min(owners)
+        # The registry linearizes acceptance with the final missed_steer drain.
+        if not steer_subagent(sid, text):
+            return {"error": "steer_not_accepted"}
+        return {"absorbed": True}
+
+    # amend reads an existing positive receipt before consulting the live owner.
+    receipt = amend(self._run_idempotency_store, self._run_idempotency_scope(request),
+                    "selfcheck:" + principal + ":" + marker, result["job_id"], text, deliver)
+    if receipt.get("error") == "run_not_accepting_steer":
+        return web.json_response({"absorbed": False})
+    if receipt.get("error"):
+        return _json_error(_api_server._openai_error, receipt["error"],
+                           code=receipt["error"], status=409)
+    return web.json_response(receipt)
