{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yimi:capability:manifest:1",
  "title": "ai.yimi.capability v1 extension",
  "description": "Validates only extensions[ai.yimi.capability], not the Agent Plugins manifest wrapper.",
  "$defs": {
    "effect": {
      "type": "string",
      "enum": [
        "observe",
        "workspace",
        "owner_data",
        "send",
        "account",
        "delete",
        "physical",
        "spend",
        "self_change"
      ]
    },
    "tool": {
      "type": "object",
      "properties": {
        "effect": {
          "$ref": "#/$defs/effect"
        },
        "effect_by_arg": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": {
            "pattern": "^\\$[.\\[]"
          },
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/effect"
            }
          }
        },
        "target": {
          "type": "string",
          "pattern": "^\\$[.\\[]"
        },
        "task_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "retry": {
          "type": "string",
          "enum": [
            "forbidden",
            "allowed",
            "after_check"
          ]
        },
        "check_with": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "context_inject": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "long_running": {
          "type": "boolean"
        },
        "send_consent": {
          "type": "object",
          "properties": {
            "recipient": {
              "enum": [
                "wechat",
                "channel"
              ]
            },
            "kind": {
              "enum": [
                "message.text",
                "message.file",
                "message.reaction",
                "message.reaction_remove"
              ]
            },
            "kinds": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "enum": [
                  "message.text",
                  "message.file",
                  "message.reaction",
                  "message.reaction_remove"
                ]
              }
            }
          },
          "required": [
            "recipient"
          ],
          "oneOf": [
            {
              "properties": {
                "kind": {}
              },
              "required": [
                "kind"
              ]
            },
            {
              "properties": {
                "kinds": {}
              },
              "required": [
                "kinds"
              ]
            }
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "effect": {}
          },
          "required": [
            "effect"
          ]
        },
        {
          "properties": {
            "effect_by_arg": {}
          },
          "required": [
            "effect_by_arg"
          ]
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema": {
      "const": "yimi.capability.v1"
    },
    "receipt_schema": {
      "const": 1
    },
    "compat": {
      "type": "object",
      "properties": {
        "hermes": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "gateway_api": {
          "const": 1
        }
      },
      "required": [
        "hermes",
        "gateway_api"
      ],
      "additionalProperties": false
    },
    "maintainer": {
      "type": "string",
      "enum": [
        "lead",
        "yimi"
      ]
    },
    "runtime": {
      "type": "object",
      "properties": {
        "server": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "lazy": {
          "type": "boolean"
        },
        "idle_timeout_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "host": {
          "type": "string",
          "enum": [
            "dedicated",
            "shared"
          ]
        }
      },
      "required": [
        "server",
        "lazy",
        "idle_timeout_seconds",
        "host"
      ],
      "additionalProperties": false
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "egress": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "egress"
      ],
      "additionalProperties": false
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "owner",
          "owner_uncertain",
          "guest",
          "build",
          "care"
        ]
      }
    },
    "tools": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "$ref": "#/$defs/tool"
      }
    },
    "staging": {
      "type": "object",
      "properties": {
        "fake": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "command",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "fake"
      ],
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "contract"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "workshop_run": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter_modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "source_commit",
        "workshop_run",
        "adapter_modules"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "receipt_schema",
    "compat",
    "maintainer",
    "runtime",
    "secrets",
    "network",
    "scopes",
    "tools",
    "staging",
    "tests",
    "provenance"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "maintainer": {
        "const": "yimi"
      }
    },
    "required": [
      "maintainer"
    ]
  },
  "then": {
    "properties": {
      "tools": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "effect": {
              "not": {
                "enum": [
                  "spend",
                  "self_change"
                ]
              }
            },
            "effect_by_arg": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "not": {
                    "enum": [
                      "spend",
                      "self_change"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
