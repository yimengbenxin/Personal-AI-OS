{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "phone": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "server/main.py"
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PAIOS_PHONE_PROVIDER": "${PAIOS_PHONE_PROVIDER}",
        "PAIOS_INTEGRATION_PORT": "${PAIOS_INTEGRATION_PORT}",
        "PAIOS_ERRAND_SPOOL": "${PAIOS_ERRAND_SPOOL}",
        "PAIOS_MOBILERUN_CONFIG": "${PAIOS_MOBILERUN_CONFIG}",
        "PAIOS_PAYMENT_URL": "${PAIOS_PAYMENT_URL}",
        "PAIOS_DEEPSEEK_KEY_FILE": "${PAIOS_DEEPSEEK_KEY_FILE}",
        "PAIOS_SILICONFLOW_KEY_FILE": "${PAIOS_SILICONFLOW_KEY_FILE}",
        "PAIOS_PAYMENT_KEY_FILE": "${PAIOS_PAYMENT_KEY_FILE}",
        "PAIOS_PHONE_STATE_DIR": "${PLUGIN_DATA}"
      }
    }
  }
}
